{
  "info": {
    "name": "3. Exercises",
    "description": "CRUD + RBAC. Требует, чтобы Setup был прогнан раньше (adminToken обязателен).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. RBAC: user POST → 403",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Should not be created\",\n  \"description\": \"desc\",\n  \"difficulty\": 5,\n  \"type\": \"weight\"\n}"
        },
        "url": { "raw": "{{base_url}}/exercises", "host": ["{{base_url}}"], "path": ["exercises"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 403', function () { pm.response.to.have.status(403); });",
              "pm.test('Error is forbidden', function () { pm.expect(pm.response.json().error).to.eql('forbidden'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. POST (admin) — success",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Жим лёжа (Postman)\",\n  \"description\": \"Базовое упражнение из Postman\",\n  \"difficulty\": 5,\n  \"type\": \"weight\"\n}"
        },
        "url": { "raw": "{{base_url}}/exercises", "host": ["{{base_url}}"], "path": ["exercises"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
              "const jsonData = pm.response.json();",
              "pm.test('Response has id and name', function () {",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData).to.have.property('name', 'Жим лёжа (Postman)');",
              "});",
              "pm.environment.set('exerciseId', jsonData.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. POST — duplicate → 409",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Жим лёжа (Postman)\",\n  \"description\": \"Другое описание\",\n  \"difficulty\": 7,\n  \"type\": \"weight\"\n}"
        },
        "url": { "raw": "{{base_url}}/exercises", "host": ["{{base_url}}"], "path": ["exercises"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 409', function () { pm.response.to.have.status(409); });",
              "pm.test('Error mentions already exists', function () {",
              "    pm.expect(pm.response.json().error).to.include('already exists');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. POST — validation → 400",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Жи\",\n  \"description\": \"desc\",\n  \"difficulty\": 5,\n  \"type\": \"weight\"\n}"
        },
        "url": { "raw": "{{base_url}}/exercises", "host": ["{{base_url}}"], "path": ["exercises"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });",
              "pm.test('Validation error mentions min', function () {",
              "    pm.expect(pm.response.json().error).to.include(\"'min' tag\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. GET — list (any user)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
        "url": { "raw": "{{base_url}}/exercises", "host": ["{{base_url}}"], "path": ["exercises"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const jsonData = pm.response.json();",
              "pm.test('Array contains our exercise', function () {",
              "    pm.expect(jsonData).to.be.an('array');",
              "    const found = jsonData.find(ex => ex.id === pm.environment.get('exerciseId'));",
              "    pm.expect(found).to.not.be.undefined;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. GET {id} — by id (any user)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
        "url": {
          "raw": "{{base_url}}/exercises/{{exerciseId}}",
          "host": ["{{base_url}}"],
          "path": ["exercises", "{{exerciseId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const jsonData = pm.response.json();",
              "pm.test('Correct exercise returned', function () {",
              "    pm.expect(jsonData.id).to.eql(pm.environment.get('exerciseId'));",
              "    pm.expect(jsonData.is_deleted).to.be.false;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. GET {id} — not found → 404",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
        "url": {
          "raw": "{{base_url}}/exercises/00000000-0000-0000-0000-000000000000",
          "host": ["{{base_url}}"],
          "path": ["exercises", "00000000-0000-0000-0000-000000000000"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 404', function () { pm.response.to.have.status(404); });",
              "pm.test('Error mentions not found', function () {",
              "    pm.expect(pm.response.json().error).to.include('not found');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8. PATCH — difficulty (admin)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"difficulty\": 9\n}" },
        "url": {
          "raw": "{{base_url}}/exercises/{{exerciseId}}",
          "host": ["{{base_url}}"],
          "path": ["exercises", "{{exerciseId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const jsonData = pm.response.json();",
              "pm.test('Only difficulty changed', function () {",
              "    pm.expect(jsonData.difficulty).to.eql(9);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "9. PATCH — name (admin)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Жим лёжа (updated)\"\n}" },
        "url": {
          "raw": "{{base_url}}/exercises/{{exerciseId}}",
          "host": ["{{base_url}}"],
          "path": ["exercises", "{{exerciseId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const jsonData = pm.response.json();",
              "pm.test('Name updated', function () {",
              "    pm.expect(jsonData.name).to.eql('Жим лёжа (updated)');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10. DELETE — 204",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }],
        "url": {
          "raw": "{{base_url}}/exercises/{{exerciseId}}",
          "host": ["{{base_url}}"],
          "path": ["exercises", "{{exerciseId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 204', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11. DELETE — repeat (idempotent)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }],
        "url": {
          "raw": "{{base_url}}/exercises/{{exerciseId}}",
          "host": ["{{base_url}}"],
          "path": ["exercises", "{{exerciseId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('Status code still 204', function () { pm.response.to.have.status(204); });"]
          }
        }
      ]
    },
    {
      "name": "12. GET — deleted not in list",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
        "url": { "raw": "{{base_url}}/exercises", "host": ["{{base_url}}"], "path": ["exercises"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const jsonData = pm.response.json();",
              "pm.test('Deleted exercise not in list', function () {",
              "    const found = jsonData.find(ex => ex.id === pm.environment.get('exerciseId'));",
              "    pm.expect(found).to.be.undefined;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "13. GET {id} — deleted returns is_deleted=true",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
        "url": {
          "raw": "{{base_url}}/exercises/{{exerciseId}}",
          "host": ["{{base_url}}"],
          "path": ["exercises", "{{exerciseId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const jsonData = pm.response.json();",
              "pm.test('is_deleted = true', function () {",
              "    pm.expect(jsonData.is_deleted).to.be.true;",
              "});"
            ]
          }
        }
      ]
    }
  ]
}