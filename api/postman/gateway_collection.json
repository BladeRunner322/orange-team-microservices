    },
    {
      "name": "4. Profiles — /users/me",
      "item": [
        {
          "name": "1. GET — пустой профиль (lazy-create)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": { "raw": "{{base_url}}/users/me", "host": ["{{base_url}}"], "path": ["users", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response has user_id, profile_completed, created_at', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('user_id');",
                  "    pm.expect(jsonData).to.have.property('profile_completed');",
                  "    pm.expect(jsonData).to.have.property('created_at');",
                  "});",
                  "pm.test('Profile is empty (profile_completed = false)', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.profile_completed).to.be.false;",
                  "    pm.expect(jsonData).to.not.have.property('sex');",
                  "    pm.expect(jsonData).to.not.have.property('weight_kg');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. PATCH — заполнить все 4 поля",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sex\": \"male\",\n  \"weight_kg\": 80.5,\n  \"birth_date\": \"1990-05-15\",\n  \"height_cm\": 180\n}"
            },
            "url": { "raw": "{{base_url}}/users/me", "host": ["{{base_url}}"], "path": ["users", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Profile is completed', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.profile_completed).to.be.true;",
                  "    pm.expect(jsonData.sex).to.eql('male');",
                  "    pm.expect(jsonData.weight_kg).to.eql(80.5);",
                  "    pm.expect(jsonData.birth_date).to.eql('1990-05-15');",
                  "    pm.expect(jsonData.height_cm).to.eql(180);",
                  "});",
                  "pm.test('updated_at is present', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('updated_at');",
                  "    pm.expect(jsonData.updated_at).to.not.be.null;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. GET — проверка сохранения",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": { "raw": "{{base_url}}/users/me", "host": ["{{base_url}}"], "path": ["users", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Profile saved correctly', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.profile_completed).to.be.true;",
                  "    pm.expect(jsonData.sex).to.eql('male');",
                  "    pm.expect(jsonData.weight_kg).to.eql(80.5);",
                  "    pm.expect(jsonData.birth_date).to.eql('1990-05-15');",
                  "    pm.expect(jsonData.height_cm).to.eql(180);",
                  "});"
                ]
              }
            }
          ]
        },
