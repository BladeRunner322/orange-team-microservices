{
  "info": {
    "name": "4. Habits",
    "description": "CRUD + отметки + стрики. Требует, чтобы Setup был прогнан раньше.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET /habits — пустой список",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
        "url": { "raw": "{{base_url}}/habits", "host": ["{{base_url}}"], "path": ["habits"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const jsonData = pm.response.json();",
              "pm.test('Empty array', function () {",
              "    pm.expect(jsonData).to.be.an('array');",
              "    pm.expect(jsonData).to.be.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. POST /habits — создать",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Пить воду (Postman)\",\n  \"description\": \"2 литра в день\"\n}"
        },
        "url": { "raw": "{{base_url}}/habits", "host": ["{{base_url}}"], "path": ["habits"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
              "const jsonData = pm.response.json();",
              "pm.test('Response has id, name, description', function () {",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData).to.have.property('name', 'Пить воду (Postman)');",
              "    pm.expect(jsonData).to.have.property('description', '2 литра в день');",
              "    pm.expect(jsonData).to.have.property('streak', 0);",
              "    pm.expect(jsonData).to.have.property('completed_today', false);",
              "});",
              "pm.environment.set('habitId', jsonData.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. POST /habits — validation → 400 (пустое имя)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\"\n}"
        },
        "url": { "raw": "{{base_url}}/habits", "host": ["{{base_url}}"], "path": ["habits"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });",
              "pm.test('Validation mentions required', function () {",
              "    pm.expect(pm.response.json().error).to.include('required');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. POST /habits — duplicate name → 409",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Пить воду (Postman)\",\n  \"description\": \"Другое\"\n}"
        },
        "url": { "raw": "{{base_url}}/habits", "host": ["{{base_url}}"], "path": ["habits"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 409', function () { pm.response.to.have.status(409); });",
              "pm.test('Error mentions already exists', function () {",
              "    pm.expect(pm.response.json().error).to.include('already exists');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. GET /habits — список содержит созданную",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
        "url": { "raw": "{{base_url}}/habits", "host": ["{{base_url}}"], "path": ["habits"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const jsonData = pm.response.json();",
              "pm.test('Array contains created habit', function () {",
              "    pm.expect(jsonData).to.be.an('array');",
              "    const found = jsonData.find(h => h.id === pm.environment.get('habitId'));",
              "    pm.expect(found).to.not.be.undefined;",
              "    pm.expect(found.name).to.eql('Пить воду (Postman)');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. GET /habits/{id} — by id",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
        "url": {
          "raw": "{{base_url}}/habits/{{habitId}}",
          "host": ["{{base_url}}"],
          "path": ["habits", "{{habitId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const jsonData = pm.response.json();",
              "pm.test('Correct habit returned', function () {",
              "    pm.expect(jsonData.id).to.eql(pm.environment.get('habitId'));",
              "    pm.expect(jsonData).to.have.property('streak');",
              "    pm.expect(jsonData).to.have.property('completed_today');",
              "});"
            ]
          }
        }
      ]
    },
    {
