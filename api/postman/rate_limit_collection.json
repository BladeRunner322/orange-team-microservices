{
  "info": {
    "name": "Rate Limiting (Gateway)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Проверка rate limiting для /login. 5 запросов проходят (401), 6-й — 429 с Retry-After. Уникальный email генерируется при каждом запуске."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Один и тот же email на все запросы в рамках одного прогона.",
          "// pm.collectionVariables живут весь run и не пересекаются с email",
          "// из env.json (Setup использует ключ 'email').",
          "if (!pm.collectionVariables.get('rateLimitEmail')) {",
          "    const ts = Date.now();",
          "    pm.collectionVariables.set('rateLimitEmail', `ratelimit_${ts}@example.com`);",
          "    pm.collectionVariables.set('rateLimitPassword', 'wrong_password_for_ratelimit');",
          "    console.log('Generated email:', pm.collectionVariables.get('rateLimitEmail'));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Login attempt (should be 401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{rateLimitEmail}}\",\n  \"password\": \"{{rateLimitPassword}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": ["{{base_url}}"],
          "path": ["login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Attempt 1: 401 Unauthorized', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login attempt (should be 401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{rateLimitEmail}}\",\n  \"password\": \"{{rateLimitPassword}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": ["{{base_url}}"],
          "path": ["login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Attempt 2: 401 Unauthorized', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Login attempt (should be 401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{rateLimitEmail}}\",\n  \"password\": \"{{rateLimitPassword}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": ["{{base_url}}"],
          "path": ["login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Attempt 3: 401 Unauthorized', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Login attempt (should be 401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{rateLimitEmail}}\",\n  \"password\": \"{{rateLimitPassword}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": ["{{base_url}}"],
          "path": ["login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Attempt 4: 401 Unauthorized', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Login attempt (should be 401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{rateLimitEmail}}\",\n  \"password\": \"{{rateLimitPassword}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": ["{{base_url}}"],
          "path": ["login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Attempt 5: 401 Unauthorized', function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Login attempt (should be 429 — rate limited)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{rateLimitEmail}}\",\n  \"password\": \"{{rateLimitPassword}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": ["{{base_url}}"],
          "path": ["login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Attempt 6: 429 Too Many Requests', function () {",
              "    pm.response.to.have.status(429);",
              "});",
              "pm.test('Retry-After header present', function () {",
              "    pm.expect(pm.response.headers.has('Retry-After')).to.be.true;",
              "    const retryAfter = parseInt(pm.response.headers.get('Retry-After'), 10);",
              "    pm.expect(retryAfter).to.be.a('number').and.to.be.above(0);",
              "    console.log('Retry-After:', retryAfter, 'seconds');",
              "});",
              "pm.test('Error message about rate limit', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.error).to.include('rate limit exceeded');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Login attempt immediately after (should be 429)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{rateLimitEmail}}\",\n  \"password\": \"{{rateLimitPassword}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": ["{{base_url}}"],
          "path": ["login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Attempt 7: still 429', function () {",
              "    pm.response.to.have.status(429);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}