{
  "info": {
    "name": "1. Auth — refresh / logout / errors",
    "description": "Refresh с rotation, logout и негативные сценарии. Требует, чтобы Setup был прогнан раньше.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Refresh success (rotation)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
        },
        "url": { "raw": "{{base_url}}/refresh", "host": ["{{base_url}}"], "path": ["refresh"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const jsonData = pm.response.json();",
              "pm.test('New tokens returned', function () {",
              "    pm.expect(jsonData).to.have.property('access_token');",
              "    pm.expect(jsonData).to.have.property('refresh_token');",
              "});",
              "pm.environment.set('accessToken', jsonData.access_token);",
              "pm.environment.set('refreshToken', jsonData.refresh_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Refresh with invalid token → 401",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"invalid-refresh-token-string-that-is-long-enough-to-pass-format-check\"\n}"
        },
        "url": { "raw": "{{base_url}}/refresh", "host": ["{{base_url}}"], "path": ["refresh"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('Status code is 401', function () { pm.response.to.have.status(401); });"]
          }
        }
      ]
    },
    {
      "name": "3. Protected without token → 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/users/me", "host": ["{{base_url}}"], "path": ["users", "me"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 401', function () { pm.response.to.have.status(401); });",
              "pm.test('Error mentions missing header', function () {",
              "    pm.expect(pm.response.json().error).to.include('missing Authorization header');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Protected with invalid token → 401",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer invalidtoken", "type": "text" }],
        "url": { "raw": "{{base_url}}/users/me", "host": ["{{base_url}}"], "path": ["users", "me"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 401', function () { pm.response.to.have.status(401); });",
              "pm.test('Error mentions invalid token', function () {",
              "    pm.expect(pm.response.json().error).to.include('invalid or expired token');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Logout success",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
        },
        "url": { "raw": "{{base_url}}/logout", "host": ["{{base_url}}"], "path": ["logout"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response has status', function () {",
              "    pm.expect(pm.response.json()).to.have.property('status');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Refresh after logout → 401",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
        },
        "url": { "raw": "{{base_url}}/refresh", "host": ["{{base_url}}"], "path": ["refresh"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 401', function () { pm.response.to.have.status(401); });",
              "pm.test('Error mentions invalid refresh', function () {",
              "    pm.expect(pm.response.json().error).to.include('invalid refresh token');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}