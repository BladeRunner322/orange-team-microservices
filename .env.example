# ============================================================
#  НАСТРОЙКИ gRPC-СЕРВЕРА
# ============================================================
# Порт, на котором сервер будет принимать gRPC-запросы
GRPC_PORT=:50051

# ============================================================
#  JWT-АУТЕНТИФИКАЦИЯ
# ============================================================
# Секретный ключ для подписи JWT (в разработке можно любой, в проде — сложный)
JWT_SECRET=# ЗАПОЛНИТЬ
# Издатель токена (кто выдал)
JWT_ISSUER=auth-service
# Аудитория токена (для какого приложения)
JWT_AUDIENCE=orange-team
# Время жизни токена (формат: 24h, 12h, 1h30m)
JWT_EXPIRATION=24h

# ============================================================
#  НАСТРОЙКИ ЛОГГЕРА
# ============================================================
# Уровень логирования: DEBUG, INFO, WARN, ERROR
LOGGER_LEVEL=DEBUG
# Формат вывода: text (читаемый) или json (структурированный)
LOGGER_FORMAT=text
# Папка, куда будут сохраняться файлы логов
LOGGER_FOLDER=logs

# ============================================================
#  РЕЖИМ РАЗРАБОТКИ
# ============================================================
# Включает gRPC reflection (для grpcurl). В продакшене должно быть false.
ENABLE_REFLECTION=true

# ============================================================
#  ПОДКЛЮЧЕНИЕ К POSTGRESQL
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=test
POSTGRES_PASSWORD=# ЗАПОЛНИТЬ
POSTGRES_DB=app
POSTGRES_SSLMODE=disable
POSTGRES_TIMEOUT=30s