# ============================================================
#  ОБЩИЕ НАСТРОЙКИ (для Docker Compose)
# ============================================================
# Этот файл используется только docker-compose.yml для подстановок
# портов на хосте. Переменные внутрь контейнеров передаются из
# services/<service>/.env через директиву env_file.

# ============================================================
#  ПОРТЫ НА ХОСТЕ (проброс)
# ============================================================

# PostgreSQL (Auth)
POSTGRES_PORT=5432

# Redis (Auth) — refresh tokens
REDIS_AUTH_PORT=6379

# Redis (Gateway) — rate limiting
REDIS_GATEWAY_PORT=6380

# Auth Service
AUTH_GRPC_PORT=50051
AUTH_HTTP_PORT=8080

# Gateway Service
GATEWAY_HTTP_PORT=8081

# ============================================================
#  МОНИТОРИНГ
# ============================================================

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
GRAFANA_PASSWORD=change_me

# Loki
LOKI_PORT=3100