# ============================================================
#  AUTH SERVICE
# ============================================================

# gRPC порт (внутри контейнера)
GRPC_PORT=:50051

# JWT
JWT_SECRET=change_me_at_least_32_chars
JWT_ISSUER=auth-service
JWT_AUDIENCE=orange-team
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Режим разработки (включает reflection для grpcurl)
ENABLE_REFLECTION=true

# PostgreSQL для Auth
POSTGRES_HOST=postgres-auth
POSTGRES_PORT=5432
POSTGRES_USER=test
POSTGRES_PASSWORD=change_me
POSTGRES_DB=auth_db
POSTGRES_TIMEOUT=30s

# Redis для refresh-токенов
REDIS_PORT=6379
REDIS_ADDR=redis-auth:6379
REDIS_PASSWORD=change_me
REDIS_DB=0

# TLS для gRPC (самоподписанные сертификаты в разработке)
ENABLE_TLS=true
TLS_CERT_FILE=/app/certs/server.crt
TLS_KEY_FILE=/app/certs/server.key

# HTTP порт для health/metrics (локальная разработка)
HTTP_PORT=:8090


# ============================================================
#  GATEWAY SERVICE
# ============================================================

# HTTP порт для Gateway (внутри контейнера)
GATEWAY_HTTP_PORT=:8081

# Адрес Auth Service для gRPC-вызовов (внутри Docker-сети)
AUTH_GRPC_ADDR=auth-service:50051

# Таймаут для gRPC-запросов к Auth (в секундах)
GATEWAY_TIMEOUT=10s


# ============================================================
#  ОБЩИЕ НАСТРОЙКИ (ЛОГГЕР, МОНИТОРИНГ)
# ============================================================

# Логгер (применяется ко всем сервисам)
LOGGER_LEVEL=DEBUG
LOGGER_FORMAT=json
LOGGER_FOLDER=logs

# Grafana
GRAFANA_PASSWORD=change_me