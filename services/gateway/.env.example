# --- HTTP ---
GATEWAY_HTTP_PORT=:8081

# --- Зависимости (gRPC) ---
AUTH_GRPC_ADDR=auth-service:50051
PROFILES_GRPC_ADDR=profiles-service:50052
EXERCISES_GRPC_ADDR=exercises-service:50053
GATEWAY_TIMEOUT=10s

# --- TLS для исходящих gRPC-соединений ---
# "disabled" — без TLS (только локально)
# "insecure" — TLS без проверки сертификата (self-signed, dev/staging)
# "verify" — TLS с проверкой (прод)
GRPC_CLIENT_TLS_MODE=insecure

# --- Trusted proxies ---
# CIDR-список доверенных прокси через запятую. Если RemoteAddr входит в список,
# Gateway обходит X-Forwarded-For справа налево и берёт первый не-trusted IP
# (защита от подделки XFF клиентом). Пусто — XFF игнорируется, IP берётся из RemoteAddr.
#
# В проде — subnet docker-сети проекта. Определить:
#   docker network inspect orange-team-microservices_default | grep Subnet
TRUSTED_PROXIES=

# --- Redis (rate limiting) ---
REDIS_ADDR=redis-gateway:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true

# /login — 5 попыток в минуту
RATE_LIMIT_LOGIN_RATE=5
RATE_LIMIT_LOGIN_BURST=5
RATE_LIMIT_LOGIN_INTERVAL=1m

# /register — 3 попытки в минуту
RATE_LIMIT_REGISTER_RATE=3
RATE_LIMIT_REGISTER_BURST=3
RATE_LIMIT_REGISTER_INTERVAL=1m

# /refresh — 20 попыток в минуту
RATE_LIMIT_REFRESH_RATE=20
RATE_LIMIT_REFRESH_BURST=20
RATE_LIMIT_REFRESH_INTERVAL=1m

# Защищённые — 60 запросов в минуту
RATE_LIMIT_DEFAULT_RATE=60
RATE_LIMIT_DEFAULT_BURST=60
RATE_LIMIT_DEFAULT_INTERVAL=1m