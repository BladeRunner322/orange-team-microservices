# --- HTTP ---
GATEWAY_HTTP_PORT=:8081

# --- Зависимости (gRPC) ---
AUTH_GRPC_ADDR=auth-service:50051
PROFILES_GRPC_ADDR=profiles-service:50052
EXERCISES_GRPC_ADDR=exercises-service:50053
GATEWAY_TIMEOUT=10s

# --- TLS для исходящих gRPC-соединений ---
# "disabled" — без TLS (только локально)
# "insecure" — TLS без проверки сертификата (self-signed, dev/staging)
# "verify" — TLS с проверкой (прод)
GRPC_CLIENT_TLS_MODE=insecure

# --- Circuit Breaker (ADR-020) ---
# Один набор параметров применяется ко всем downstream (Auth, Profiles, Exercises).
# При открытом breaker вызовы падают мгновенно (fail-fast) — Gateway
# возвращает клиенту 503 вместо ожидания таймаута.

# Включить CB на всех клиентах.
GATEWAY_CB_ENABLED=true

# Half-open: сколько успешных запросов подряд закроют breaker.
GATEWAY_CB_MAX_REQUESTS=1

# Окно подсчёта ошибок.
GATEWAY_CB_INTERVAL=60s

# Сколько breaker висит в OPEN до первой проверки.
GATEWAY_CB_TIMEOUT=30s

# Минимум запросов в окне для расчёта доли ошибок.
GATEWAY_CB_MIN_REQUESTS=10

# Доля ошибок (0..1), при превышении — OPEN.
GATEWAY_CB_ERROR_RATE=0.5

# --- Retry (ADR-020) ---
# Retry применяется только к методам из whitelist (read-only).
# Мутации не ретраятся — см. ADR-020, п.3.

GATEWAY_RETRY_ENABLED=true

# Максимум попыток включая первую.
GATEWAY_RETRY_MAX_ATTEMPTS=3

# Exponential backoff: начальная и максимальная задержка.
GATEWAY_RETRY_BASE_DELAY=100ms
GATEWAY_RETRY_MAX_DELAY=1s

# Whitelist read-only методов. Формат: "/package.Service/Method",
# через запятую без пробелов.
GATEWAY_RETRY_IDEMPOTENT_METHODS=/auth.AuthService/ValidateToken,/profiles.ProfilesService/GetMyProfile,/profiles.ProfilesService/GetProfile,/exercises.ExercisesService/GetExercise,/exercises.ExercisesService/GetExercises

# --- Trusted proxies ---
# CIDR-список доверенных прокси через запятую. Если RemoteAddr входит в список,
# Gateway обходит X-Forwarded-For справа налево и берёт первый не-trusted IP
# (защита от подделки XFF клиентом). Пусто — XFF игнорируется, IP берётся из RemoteAddr.
#
# В проде — subnet docker-сети проекта. Определить:
#   docker network inspect orange-team-microservices_default | grep Subnet
TRUSTED_PROXIES=

# --- Redis (rate limiting) ---
REDIS_ADDR=redis-gateway:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true

# /login — 5 попыток в минуту
RATE_LIMIT_LOGIN_RATE=5
RATE_LIMIT_LOGIN_BURST=5
RATE_LIMIT_LOGIN_INTERVAL=1m

# /register — 3 попытки в минуту
RATE_LIMIT_REGISTER_RATE=3
RATE_LIMIT_REGISTER_BURST=3
RATE_LIMIT_REGISTER_INTERVAL=1m

# /refresh — 20 попыток в минуту
RATE_LIMIT_REFRESH_RATE=20
RATE_LIMIT_REFRESH_BURST=20
RATE_LIMIT_REFRESH_INTERVAL=1m

# Защищённые — 60 запросов в минуту
RATE_LIMIT_DEFAULT_RATE=60
RATE_LIMIT_DEFAULT_BURST=60
RATE_LIMIT_DEFAULT_INTERVAL=1m