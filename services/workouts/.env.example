# --- gRPC ---
GRPC_PORT=:50055

# --- Зависимости (gRPC) ---
PROFILES_GRPC_ADDR=profiles-service:50052
EXERCISES_GRPC_ADDR=exercises-service:50053
GRPC_CLIENT_TLS_MODE=insecure
WORKOUTS_TIMEOUT=10s

# --- Разработка ---
ENABLE_REFLECTION=true

# --- PostgreSQL ---
POSTGRES_HOST=postgres-workouts
POSTGRES_PORT=5432
POSTGRES_USER=test
POSTGRES_PASSWORD=
POSTGRES_DB=workouts_db
POSTGRES_TIMEOUT=30s

# --- TLS ---
ENABLE_TLS=true
TLS_CERT_FILE=/app/certs/server.crt
TLS_KEY_FILE=/app/certs/server.key

# --- HTTP (healthcheck, metrics) ---
HTTP_PORT=:8080

# --- Логирование ---
LOGGER_FORMAT=json