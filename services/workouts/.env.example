# --- gRPC ---
GRPC_PORT=:50055

# --- Зависимости (gRPC) ---
PROFILES_GRPC_ADDR=profiles-service:50052
EXERCISES_GRPC_ADDR=exercises-service:50053
GRPC_CLIENT_TLS_MODE=insecure
WORKOUTS_TIMEOUT=10s

# --- Разработка ---
ENABLE_REFLECTION=true

# --- PostgreSQL ---
POSTGRES_HOST=postgres-workouts
POSTGRES_PORT=5432
POSTGRES_USER=test
POSTGRES_PASSWORD=
POSTGRES_DB=workouts_db
POSTGRES_TIMEOUT=30s

# --- TLS ---
ENABLE_TLS=true
TLS_CERT_FILE=/app/certs/server.crt
TLS_KEY_FILE=/app/certs/server.key

# --- HTTP (healthcheck, metrics) ---
HTTP_PORT=:8080

# --- Circuit Breaker (ADR-020) ---
# Один набор параметров применяется ко всем downstream (Profiles, Exercises).
# При открытом breaker вызовы падают мгновенно (fail-fast).

# Включить CB на всех клиентах.
WORKOUTS_CB_ENABLED=true

# Half-open: сколько успешных запросов подряд закроют breaker.
WORKOUTS_CB_MAX_REQUESTS=1

# Окно подсчёта ошибок.
WORKOUTS_CB_INTERVAL=60s

# Сколько breaker висит в OPEN до первой проверки.
WORKOUTS_CB_TIMEOUT=30s

# Минимум запросов в окне для расчёта доли ошибок.
WORKOUTS_CB_MIN_REQUESTS=10

# Доля ошибок (0..1), при превышении — OPEN.
WORKOUTS_CB_ERROR_RATE=0.5

# --- Retry (ADR-020) ---
# Retry применяется только к методам из whitelist (read-only).
# Мутации не ретраятся — см. ADR-020, п.3.

WORKOUTS_RETRY_ENABLED=true

# Максимум попыток включая первую.
WORKOUTS_RETRY_MAX_ATTEMPTS=3

# Exponential backoff: начальная и максимальная задержка.
WORKOUTS_RETRY_BASE_DELAY=100ms
WORKOUTS_RETRY_MAX_DELAY=1s

# Whitelist read-only методов. Формат: "/package.Service/Method",
# через запятую без пробелов.
WORKOUTS_RETRY_IDEMPOTENT_METHODS=/profiles.ProfilesService/GetProfile,/exercises.ExercisesService/GetExercise

# --- Логирование ---
LOGGER_FORMAT=json