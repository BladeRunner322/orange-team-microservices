# --- gRPC ---
GRPC_PORT=:50052

# --- Разработка ---
ENABLE_REFLECTION=true

# --- PostgreSQL ---
POSTGRES_HOST=postgres-profiles
POSTGRES_PORT=5432
POSTGRES_USER=test
POSTGRES_PASSWORD=
POSTGRES_DB=profiles_db
POSTGRES_TIMEOUT=30s

# --- TLS ---
ENABLE_TLS=true
TLS_CERT_FILE=/app/certs/server.crt
TLS_KEY_FILE=/app/certs/server.key

# --- HTTP (healthcheck, metrics) ---
HTTP_PORT=:8080