# ============================================================
#  AUTH SERVICE
# ============================================================

# ============================================================
#  gRPC-СЕРВЕР
# ============================================================
# Порт, на котором gRPC-сервер слушает внутри контейнера
GRPC_PORT=:50051

# ============================================================
#  JWT
# ============================================================
# Секретный ключ для подписи JWT (минимум 32 байта)
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=change_me_at_least_32_chars
# Издатель токена
JWT_ISSUER=auth-service
# Аудитория токена
JWT_AUDIENCE=orange-team
# Время жизни access-токена (15 минут)
ACCESS_TOKEN_TTL=15m
# Время жизни refresh-токена (30 дней)
REFRESH_TOKEN_TTL=720h

# ============================================================
#  РЕЖИМ РАЗРАБОТКИ
# ============================================================
# gRPC reflection (для grpcurl). В проде — false.
ENABLE_REFLECTION=true

# ============================================================
#  POSTGRESQL
# ============================================================
# Хост PostgreSQL внутри Docker-сети
POSTGRES_HOST=postgres-auth
# Порт PostgreSQL внутри контейнера
POSTGRES_PORT=5432
# Пользователь БД
POSTGRES_USER=test
# Пароль БД
POSTGRES_PASSWORD=change_me
# Имя базы данных
POSTGRES_DB=auth_db
# Таймаут операций с БД
POSTGRES_TIMEOUT=30s

# ============================================================
#  REDIS (refresh-токены)
# ============================================================
# Адрес Redis внутри Docker-сети
REDIS_ADDR=redis-auth:6379
# Пароль Redis (для локали можно простой, для прода — openssl rand -hex 32)
REDIS_PASSWORD=change_me
# Номер логической БД (0 — по умолчанию)
REDIS_DB=0

# ============================================================
#  TLS
# ============================================================
# Использовать TLS для gRPC
ENABLE_TLS=true
# Путь к сертификату (внутри контейнера)
TLS_CERT_FILE=/app/certs/server.crt
# Путь к приватному ключу (внутри контейнера)
TLS_KEY_FILE=/app/certs/server.key

# ============================================================
#  HTTP (healthcheck, metrics)
# ============================================================
# Порт HTTP-сервера внутри контейнера
HTTP_PORT=:8080