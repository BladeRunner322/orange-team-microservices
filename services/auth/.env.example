# --- gRPC ---
GRPC_PORT=:50051

# --- JWT ---
# Секрет для подписи JWT (минимум 32 байта). Сгенерировать: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=auth-service
JWT_AUDIENCE=orange-team
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# --- Разработка ---
ENABLE_REFLECTION=true

# --- PostgreSQL ---
POSTGRES_HOST=postgres-auth
POSTGRES_PORT=5432
POSTGRES_USER=test
POSTGRES_PASSWORD=
POSTGRES_DB=auth_db
POSTGRES_TIMEOUT=30s

# --- Redis (refresh-токены) ---
REDIS_ADDR=redis-auth:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- TLS ---
ENABLE_TLS=true
TLS_CERT_FILE=/app/certs/server.crt
TLS_KEY_FILE=/app/certs/server.key

# --- HTTP (healthcheck, metrics) ---
HTTP_PORT=:8080

# --- Логирование ---
# Формат логов: "json" или "text". JSON обязателен для извлечения
# request_id / user_id в structured metadata Loki (ADR-007 O-2).
LOGGER_FORMAT=json