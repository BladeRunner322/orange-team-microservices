# ============================================================
#  USERS SERVICE
# ============================================================

# ============================================================
#  gRPC-СЕРВЕР
# ============================================================
# Порт, на котором gRPC-сервер слушает внутри контейнера
GRPC_PORT=:50052

# ============================================================
#  РЕЖИМ РАЗРАБОТКИ
# ============================================================
# gRPC reflection (для grpcurl). В проде — false.
ENABLE_REFLECTION=true

# ============================================================
#  POSTGRESQL
# ============================================================
# Хост PostgreSQL внутри Docker-сети
POSTGRES_HOST=postgres-users
# Порт PostgreSQL внутри контейнера
POSTGRES_PORT=5432
# Пользователь БД
POSTGRES_USER=test
# Пароль БД
POSTGRES_PASSWORD=12345678
# Имя базы данных
POSTGRES_DB=users_db
# Таймаут операций с БД
POSTGRES_TIMEOUT=30s

# ============================================================
#  TLS
# ============================================================
# Использовать TLS для gRPC
ENABLE_TLS=true
# Путь к сертификату (внутри контейнера)
TLS_CERT_FILE=/app/certs/server.crt
# Путь к приватному ключу
TLS_KEY_FILE=/app/certs/server.key

# ============================================================
#  HTTP (healthcheck, metrics)
# ============================================================
# Порт HTTP-сервера внутри контейнера
HTTP_PORT=:8080
